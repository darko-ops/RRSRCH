# rrsrch configuration (all keys are prefixed RRSRCH_)

# storage: "postgres" (deployable) or "memory" (demo/tests)
RRSRCH_STORE=postgres
RRSRCH_DATABASE_URL=postgresql+asyncpg://rrsrch:rrsrch@localhost:5432/rrsrch

# embeddings: "local" (sentence-transformers, offline) or "hash" (deterministic fallback)
RRSRCH_EMBEDDER=local
RRSRCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
RRSRCH_EMBEDDING_DIM=384

# trust thresholds (the deterministic engine)
RRSRCH_SERVE_THRESHOLD=0.70
RRSRCH_RETIRE_FLOOR=0.15
RRSRCH_BASE_CONFIDENCE=0.80

# matching
RRSRCH_SIMILARITY_FLOOR=0.82
RRSRCH_AGREEMENT_FLOOR=0.90

# decay half-lives (days)
RRSRCH_HALF_LIFE_LOW_DAYS=180
RRSRCH_HALF_LIFE_MEDIUM_DAYS=14
RRSRCH_HALF_LIFE_HIGH_DAYS=1

# telemetry: what a full cold-path derivation costs (tokens)
RRSRCH_COLD_PATH_ESTIMATE_TOKENS=90000
