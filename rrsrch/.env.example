# rrsrch config (all keys prefixed RRSRCH_)
RRSRCH_STORE=postgres
RRSRCH_DATABASE_URL=postgresql+asyncpg://rrsrch:rrsrch@localhost:5432/rrsrch

# embeddings: local (sentence-transformers) | hash (offline) | api
RRSRCH_EMBEDDER=local
RRSRCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
RRSRCH_EMBEDDING_DIM=384
# RRSRCH_EMBEDDING_API_URL=

# matching (tune these — hit rate is the value prop)
RRSRCH_SIMILARITY_THRESHOLD=0.85
RRSRCH_CANDIDATE_K=20
RRSRCH_VECTOR_WEIGHT=0.7
RRSRCH_LEXICAL_WEIGHT=0.3

# freshness (simple decay)
RRSRCH_FRESHNESS_THRESHOLD=0.5
RRSRCH_HALF_LIFE_LOW_DAYS=180
RRSRCH_HALF_LIFE_MEDIUM_DAYS=3
RRSRCH_HALF_LIFE_HIGH_HOURS=6

# telemetry
RRSRCH_COLD_PATH_ESTIMATE_TOKENS=90000
